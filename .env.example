# Copy to .env.local for local development. Accounts switch on only when all
# of DATABASE_URL, BETTER_AUTH_SECRET and the three DISCORD_ values are set;
# otherwise the dashboard works exactly as before.

# Postgres. On Vercel this comes from the Neon integration.
DATABASE_URL=postgres://user:password@localhost:5432/moon_dev

# `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Where the app is served; Discord redirects to $BETTER_AUTH_URL/api/auth/callback/discord.
# Only needed locally: on Vercel it's worked out automatically.
BETTER_AUTH_URL=http://localhost:3000

# Discord application (https://discord.com/developers/applications), OAuth2 tab
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The server whose members may sign in (Developer Mode on, right-click the server, Copy Server ID)
DISCORD_GUILD_ID=
